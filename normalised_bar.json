{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Proportional Crop Mix by State (2022)",
    "subtitle": "Each bar = 100% · shows crop specialisation per state · flowers excluded",
    "fontSize": 15, "subtitleFontSize": 12, "subtitleColor": "#5a5a54",
    "anchor": "start", "font": "DM Sans", "subtitleFont": "DM Sans", "fontWeight": "bold", "offset": 12
  },
  "width": "container",
  "height": 380,
  "data": { "url": "data/crops_state.csv", "format": { "type": "csv", "parse": { "production": "number", "planted_area": "number", "date": "date" } } },
  "transform": [
    { "filter": "year(datum.date) == 2022 && datum.state != 'Malaysia' && datum.crop_type != 'flower'" }
  ],
  "mark": { "type": "bar" },
  "encoding": {
    "x": {
      "field": "state", "type": "nominal",
      "sort": { "field": "production", "op": "sum", "order": "descending" },
      "axis": { "title": null, "labelAngle": -35, "labelFont": "DM Sans", "labelFontSize": 11, "grid": false }
    },
    "y": {
      "aggregate": "sum", "field": "production", "type": "quantitative", "stack": "normalize",
      "axis": { "title": "Share of Production", "titleFont": "DM Sans", "labelFont": "DM Sans", "labelFontSize": 11, "titleFontSize": 12, "format": "%", "grid": true, "gridColor": "#f0ede8" }
    },
    "color": {
      "field": "crop_type", "type": "nominal",
      "scale": {
        "domain": ["paddy","fruits","vegetables","industrial_crops","coconut","cash_crops","spices","herbs"],
        "range": ["#577590","#f8961e","#43aa8b","#2d6a4f","#74c69d","#d4850a","#f3722c","#90be6d"]
      },
      "legend": {
        "title": "Crop Type", "titleFont": "DM Sans", "labelFont": "DM Sans", "titleFontSize": 12, "labelFontSize": 11, "orient": "right",
        "labelExpr": "{'paddy':'Paddy','fruits':'Fruits','vegetables':'Vegetables','industrial_crops':'Industrial Crops','coconut':'Coconut','cash_crops':'Cash Crops','spices':'Spices','herbs':'Herbs'}[datum.label]"
      }
    },
    "tooltip": [
      { "field": "state", "title": "State", "type": "nominal" },
      { "field": "crop_type", "title": "Crop Type", "type": "nominal" },
      { "aggregate": "sum", "field": "production", "title": "Production (tonnes)", "type": "quantitative", "format": ",.0f" }
    ]
  },
  "config": { "view": { "stroke": null }, "background": "#ffffff", "font": "DM Sans" }
}
