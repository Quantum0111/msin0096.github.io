{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Crop Yield by State (2022)",
    "subtitle": "Total production ÷ planted area in tonnes per hectare · flowers excluded · hover for details",
    "fontSize": 15, "subtitleFontSize": 12, "subtitleColor": "#5a5a54",
    "anchor": "start", "font": "DM Sans", "subtitleFont": "DM Sans", "fontWeight": "bold", "offset": 12
  },
  "width": "container",
  "height": 420,
  "projection": { "type": "mercator" },
  "data": {
    "url": "js/malaysia-states.topojson",
    "format": { "type": "topojson", "feature": "states" }
  },
  "transform": [
    {
      "calculate": "datum.properties.Name == 'Penang' ? 'Penang' : datum.properties.Name == 'Kuala Lumpur' ? 'Kuala Lumpur' : datum.properties.Name == 'Labuan' ? 'Labuan' : datum.properties.Name",
      "as": "state_key"
    },
    {
      "lookup": "state_key",
      "from": {
        "data": { "url": "data/crops_state.csv", "format": { "type": "csv", "parse": { "production": "number", "planted_area": "number", "date": "date" } } },
        "key": "state",
        "fields": ["production", "planted_area", "date", "crop_type"]
      }
    },
    { "filter": "year(datum.date) == 2022 && datum.crop_type != 'flower'" },
    {
      "joinaggregate": [
        { "op": "sum", "field": "production",  "as": "total_production" },
        { "op": "sum", "field": "planted_area", "as": "total_planted" }
      ],
      "groupby": ["properties.Name"]
    },
    { "calculate": "datum.total_planted > 0 ? datum.total_production / datum.total_planted : null", "as": "yield_per_ha" },
    { "window": [{ "op": "row_number", "as": "rn" }], "groupby": ["properties.Name"] },
    { "filter": "datum.rn == 1" }
  ],
  "mark": { "type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.2 },
  "encoding": {
    "color": {
      "field": "yield_per_ha", "type": "quantitative",
      "scale": { "type": "threshold", "domain": [4, 6, 8, 11, 14], "range": ["#edf7f0","#b7e4c7","#74c69d","#40916c","#2d6a4f","#1b4332"] },
      "legend": { "title": "Tonnes / hectare", "titleFont": "DM Sans", "labelFont": "DM Sans", "titleFontSize": 12, "labelFontSize": 11, "orient": "bottom-right", "symbolType": "square", "symbolSize": 220, "symbolStrokeWidth": 0 }
    },
    "tooltip": [
      { "field": "properties.Name",  "title": "State",               "type": "nominal" },
      { "field": "total_production", "title": "Production (tonnes)",  "type": "quantitative", "format": ",.0f" },
      { "field": "total_planted",    "title": "Planted Area (ha)",    "type": "quantitative", "format": ",.0f" },
      { "field": "yield_per_ha",     "title": "Yield (tonnes/ha)",    "type": "quantitative", "format": ".2f" }
    ]
  },
  "config": { "view": { "stroke": null }, "background": "#ffffff", "font": "DM Sans" }
}
